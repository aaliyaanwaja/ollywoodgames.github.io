{
  "name": "omt-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "sync-game": "node scripts/sync-game.js",
    "art": "python3 scripts/make-art.py",
    "start": "npm run sync-game && expo start",
    "android": "npm run sync-game && expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node scripts/sync-game.js --check && node tests/shell.test.js && python3 tests/bridge_test.py",
    "check": "npm run typecheck && npm run lint && npm test",
    "eas-build-pre-install": "node scripts/sync-game.js --check --lenient"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-dev-client": "~58.0.21",
    "expo-haptics": "~58.0.8",
    "expo-navigation-bar": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
