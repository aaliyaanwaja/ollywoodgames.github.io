{
  "name": "omt-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "sync-game": "node scripts/sync-game.js",
    "start": "npm run sync-game && expo start",
    "android": "npm run sync-game && expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node scripts/sync-game.js --check && python3 tests/bridge_test.py",
    "check": "npm run typecheck && npm run lint && npm test",
    "eas-build-pre-install": "node scripts/eas-check.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-navigation-bar": "~58.0.4",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
